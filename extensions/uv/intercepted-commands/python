#!/bin/bash

# Resolve uv. Prefer PATH, but fall back to mypac's mise-managed uv so the
# globally-installed extension works from other project directories.
SHIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MYPAC_ROOT="$(cd "$SHIM_DIR/../../.." && pwd)"

resolve_uv() {
	local mise_bin uv_bin

	uv_bin="$(type -P uv 2>/dev/null || true)"
	if [ -n "$uv_bin" ] && [ -x "$uv_bin" ]; then
		echo "$uv_bin"
		return 0
	fi

	mise_bin="$(type -P mise 2>/dev/null || true)"
	if [ -n "$mise_bin" ] && [ -x "$mise_bin" ]; then
		uv_bin="$("$mise_bin" which -C "$MYPAC_ROOT" uv 2>/dev/null || true)"
		if [ -n "$uv_bin" ] && [ -x "$uv_bin" ]; then
			echo "$uv_bin"
			return 0
		fi
	fi

	return 1
}

UV_BIN="$(resolve_uv)"

# Check uv is available before anything else
if [ -z "$UV_BIN" ]; then
    echo "Error: uv is required by Pi's Python capture extension, but no executable uv was found on PATH." >&2
    echo "" >&2
    echo "  Install uv with your preferred tool, for example: mise install uv or brew install uv" >&2
    echo "  Shell functions and aliases named uv are ignored; uv must be an executable." >&2
    echo "  To use system python3 directly, run 'pi config' and disable only the uv extension." >&2
    echo "  To disable all extensions for one run, start Pi with '--no-extensions'." >&2
    echo "" >&2
    exit 127
fi

# Inspect interpreter options only, never -c source or script/module arguments.
args=("$@")
module=""
for ((i = 0; i < ${#args[@]}; i++)); do
    arg="${args[i]}"
    case "$arg" in
        -m) module="${args[i+1]}"; break ;;
        -m*) module="${arg#-m}"; break ;;
        -c*|--|-|[!-]*) break ;;
        -W|-X|--check-hash-based-pycs) ((i++)) ;;
    esac
done
case "$module" in
        pip)
            echo "Error: 'python -m pip' is disabled. Use uv instead:" >&2
            echo "" >&2
            echo "  To install a package for a script: uv run --with PACKAGE python script.py" >&2
            echo "  To add a dependency to the project: uv add PACKAGE" >&2
            echo "" >&2
            exit 1
            ;;
        venv)
            echo "Error: 'python -m venv' is disabled. Use uv instead:" >&2
            echo "" >&2
            echo "  To create a virtual environment: uv venv" >&2
            echo "" >&2
            exit 1
            ;;
        py_compile)
            echo "Error: 'python -m py_compile' is disabled because it writes .pyc files to __pycache__." >&2
            echo "" >&2
            echo "  To verify syntax without bytecode output: uv run python -m ast path/to/file.py >/dev/null" >&2
            echo "" >&2
            exit 1
            ;;
esac

# Resolve a Python interpreter for uv. Prefer uv-managed Python to match
# `uv run python` defaults, while still avoiding shim recursion.
resolve_uv_python() {
	local candidate candidate_dir

	candidate="$("$UV_BIN" python find --managed-python 2>/dev/null || true)"
	if [ -n "$candidate" ] && [ -x "$candidate" ]; then
		candidate_dir="$(cd "$(dirname "$candidate")" && pwd)"
		if [ "$candidate_dir" != "$SHIM_DIR" ]; then
			echo "$candidate"
			return 0
		fi
	fi

	while IFS= read -r candidate; do
		[ -n "$candidate" ] || continue
		candidate_dir="$(cd "$(dirname "$candidate")" && pwd)"
		[ "$candidate_dir" = "$SHIM_DIR" ] && continue
		echo "$candidate"
		return 0
	done < <(type -aP python3 2>/dev/null)

	while IFS= read -r candidate; do
		[ -n "$candidate" ] || continue
		candidate_dir="$(cd "$(dirname "$candidate")" && pwd)"
		[ "$candidate_dir" = "$SHIM_DIR" ] && continue
		echo "$candidate"
		return 0
	done < <(type -aP python 2>/dev/null)

	return 1
}

UV_PYTHON="$(resolve_uv_python)"
if [ -z "$UV_PYTHON" ]; then
    echo "Error: Unable to locate a Python interpreter outside intercepted-commands." >&2
    exit 1
fi

# Dispatch through uv with an explicit interpreter path to avoid recursion.
exec "$UV_BIN" run --python "$UV_PYTHON" python "$@"
